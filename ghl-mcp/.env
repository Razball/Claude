# ============================================================
# GoHighLevel MCP Server — Environment Variables
# ============================================================
# Fill in your credentials below, then save this file.
# NEVER commit this file to source control.

# ----------------------------------------------------------
# OPTION A: Private Integration Token (simple / internal use)
# Generate from: GHL Settings > Integrations > API Keys
# ----------------------------------------------------------
GHL_API_KEY=your_private_integration_token_here

# ----------------------------------------------------------
# OPTION B: OAuth 2.0 (recommended for production)
# Create an app at: https://marketplace.gohighlevel.com
# ----------------------------------------------------------
GHL_CLIENT_ID=your_oauth_client_id_here
GHL_CLIENT_SECRET=your_oauth_client_secret_here
GHL_ACCESS_TOKEN=your_oauth_access_token_here
GHL_REFRESH_TOKEN=your_oauth_refresh_token_here

# ----------------------------------------------------------
# Sub-Account (Location) ID
# Found in: GHL Settings > Business Profile (or URL bar)
# ----------------------------------------------------------
GHL_LOCATION_ID=your_location_id_here

# ----------------------------------------------------------
# API Base URL (do not change unless using a custom domain)
# ----------------------------------------------------------
GHL_BASE_URL=https://services.leadconnectorhq.com
